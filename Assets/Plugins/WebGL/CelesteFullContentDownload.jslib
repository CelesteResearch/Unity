mergeInto(LibraryManager.library, {
    $CelesteFullContentDownloadFactory: {},
    $CelesteFullContentDownloadFactory__postset:
        "(function(){(function (root, factory) {\r\n    'use strict';\r\n    if (typeof module === 'object' && module && module.exports) module.exports = factory;\r\n    else root.createFullContentDownload = factory;\r\n})(typeof globalThis !== 'undefined' ? globalThis : this, function (settings) {\r\n    'use strict';\r\n    const names = ['manifestUrl', 'contentBaseUrl', 'bankIndexUrl', 'cacheScriptUrl', 'pageSourceScriptUrl', 'workerUrl'];\r\n    const configuration = {};\r\n    for (const name of names) {\r\n        if (typeof settings[name] !== 'string' || !settings[name]) throw new Error('Resource download URL is missing: ' + name);\r\n        configuration[name] = new URL(settings[name], globalThis.location.href).href;\r\n    }\r\n    let snapshot = {\r\n        state: 'Idle', readyBytes: 0, totalBytes: 0, cachedBytes: 0,\r\n        receivedBytes: 0, downloadedBytes: 0,\r\n        readyFiles: 0, totalFiles: 0, currentPath: '', error: ''\r\n    };\r\n    let worker, promise, resolve, disposed = false;\r\n    function readProgress() { return { ...snapshot }; }\r\n    function finish(value) {\r\n        snapshot = value;\r\n        if (worker) {\r\n            worker.onmessage = null;\r\n            worker.onerror = null;\r\n            worker.terminate();\r\n            worker = null;\r\n        }\r\n        const complete = resolve;\r\n        resolve = null;\r\n        if (complete) complete(readProgress());\r\n    }\r\n    function start() {\r\n        if (disposed) throw new Error('Full resource download was disposed.');\r\n        if (worker) return promise;\r\n        snapshot = {\r\n            state: 'Running', readyBytes: 0, totalBytes: 0, cachedBytes: 0,\r\n            receivedBytes: 0, downloadedBytes: 0,\r\n            readyFiles: 0, totalFiles: 0, currentPath: '', error: ''\r\n        };\r\n        promise = new Promise(complete => { resolve = complete; });\r\n        try {\r\n            worker = new Worker(configuration.workerUrl);\r\n            worker.onmessage = event => {\r\n                if (event.data.type === 'progress') snapshot = event.data.progress;\r\n                else if (event.data.type === 'settled') finish(event.data.progress);\r\n            };\r\n            worker.onerror = event => {\r\n                if (event.preventDefault) event.preventDefault();\r\n                finish({ ...snapshot, state: 'Failed', error: String(event.message || 'Resource worker failed.') });\r\n            };\r\n            worker.postMessage({ type: 'start', settings: configuration });\r\n        } catch (error) { finish({ ...snapshot, state: 'Failed', error: String(error.message || error) }); }\r\n        return promise;\r\n    }\r\n    function cancel() { if (worker) worker.postMessage({ type: 'cancel' }); }\r\n    function dispose() {\r\n        if (disposed) return;\r\n        disposed = true;\r\n        if (worker) finish({ ...snapshot, state: 'Cancelled', error: '' });\r\n    }\r\n    return { start, cancel, readProgress, dispose };\r\n});\r\n\nCelesteFullContentDownloadFactory=createFullContentDownload;})();",
});
